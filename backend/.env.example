# Aegis Bank Intelligence Configuration

# Environment
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration
# Supported types: "mysql" (preferred) or "sqlite" (fallback/standalone)
DATABASE_TYPE=sqlite
DATABASE_PATH=backend/aegis_bank.db

# MySQL Settings (used when DATABASE_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=aegis_bank

# Simulation & Security Thresholds
DEMO_ADMIN_API_KEY=aegis-intel-admin-secret-key-2025
SIMULATION_MODE=true
MAX_DAILY_TRANSFER_DEFAULT=10000.00
PER_TRANSACTION_LIMIT_DEFAULT=5000.00
BURST_WINDOW_MINUTES=5
BURST_THRESHOLD_COUNT=3
